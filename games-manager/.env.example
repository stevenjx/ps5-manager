# =============================================================================
# Games Manager —— 环境变量样例
# 用法：cp .env.example .env  &&  vim .env
# -----------------------------------------------------------------------------
# 所有敏感凭证只存在于 .env（请加入 .gitignore），docker-compose.yml 仅做引用。
# 变量名均为 RomM 5.4.0 的准确枚举名（backend/config/__init__.py），未做猜测。
# =============================================================================

# ---- 对外访问端口 ----
ROMM_HTTP_PORT=8080

# ---- 数据库口令（MariaDB）----
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_PASSWORD=change-me-romm-db-password

# ---- 缓存口令（Valkey）----
VALKEY_PASSWORD=change-me-valkey-password

# ---- 会话/令牌签名密钥（强烈建议设置）----
# 生成方式：openssl rand -hex 32
# 留空时容器会自动随机生成并打印告警，但重启后已登录会话全部失效。
ROMM_AUTH_SECRET_KEY=

# ---- 主力通用源：IGDB ----
# 在 Twitch Developer Portal 注册应用（Category: Application Integration,
# Client Type: Confidential），Name 需全局唯一，建议 romm-<随机串>。
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---- 美化与高清素材源：SteamGridDB ----
# https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=
