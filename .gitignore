# Runtime data (用户数据，非源码) —— 同样锚定到根目录
# =============================================================================
/config/
/covers/
/meta-cache/
*.db
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# WorkBuddy
.workbuddy-ai/

# 用户上传 / 测试数据
/test_games/
/test_config/

