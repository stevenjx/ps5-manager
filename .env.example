# =============================================================================
# Games Manager（console-manager）环境变量样例
# 用法：cp .env.example .env && vim .env
# -----------------------------------------------------------------------------
# 敏感凭证只写在 .env（请加入 .gitignore），docker-compose.yml 仅做引用，
# 代码中不存在任何硬编码 API Key。
#
# 重要：本应用【无需任何 API Key】即可完成元数据刮削（含中文名与中文简介）。
#   免 Key 数据源：本地 gamelist.xml（中文简介/译名）· Bangumi 番组计划（中文名/中文简介）
#                 · Switch TitleDB（Switch 官方数据）· Hasheous · Playmatch
#   下面 IGDB / SteamGridDB 是可选增强（主要补充高清素材），留空即可。
# =============================================================================

# ---- 服务 ----
PORT=8280
CONFIG_DIR=/config
PKG_DIR=/packages
# NAS 的实际局域网 IP（用于生成 PS5 可访问的下载地址），留空则自动探测
EXTERNAL_IP=
# 游戏目录实时监测间隔；设为 0 关闭
WATCH_INTERVAL=5s

# ---- 元数据刮削开关 ----
METADATA_ENABLED=true
# Bangumi 番组计划：免 Key 的简体中文元数据源（中文名 / 中文简介 / 开发商 / 发行商 / 评分）
BANGUMI_ENABLED=true
HASHEOUS_API_ENABLED=true
PLAYMATCH_API_ENABLED=true
# Switch TitleDB 官方库约 90MB，首次下载后缓存 7 天
SWITCH_TITLEDB_ENABLED=true

# ---- 可选增强：IGDB ----
# 申请地址：https://dev.twitch.tv/console/apps
#   Category: Application Integration / Client Type: Confidential
#   名称需全局唯一，建议 romm-<随机串>；需 Twitch 账号 + 手机 2FA
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---- 可选增强：SteamGridDB ----
# 申请地址：https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# ---- 刮削行为（可选）----
# 语言优先级（RomM 官方枚举）
METADATA_LANGUAGE=zh,en
# 地区优先级（RomM 官方 shortcode）
METADATA_REGION=cn,us,eu,jp,wor
METADATA_CONCURRENCY=4
METADATA_TIMEOUT=20s
METADATA_CACHE_DIR=meta-cache
